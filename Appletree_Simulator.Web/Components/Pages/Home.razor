@using Appletree_Simulator.Core
@page "/"
@rendermode InteractiveServer
<PageTitle>Home</PageTitle>

<h1>Let's pick some Apples</h1>

@foreach (Apple apple in garden.GetApples())
{
    <button @onclick="() => Pick(apple)"
            style="background-color: transparent; 
                   border: none; 
                   padding: 0;">
        <AppleDesign/>
    </button>
}
<h3>Basket:</h3>
@for (int i = 0; i < basket.Apples.Count; i++)
{
    <AppleDesign/>
}